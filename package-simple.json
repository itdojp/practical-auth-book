{
  "name": "practical-auth-book",
  "version": "1.0.0",
  "description": "認証・認可システムの設計と実装を体系的に学ぶ実践的な技術書",
  "author": "ITDO Inc.（株式会社アイティードゥ）",
  "license": "CC-BY-NC-SA-4.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "setup": "node easy-setup.js",
    "build": "node scripts/build-simple.js",
    "build:full": "npm run build:safe",
    "preview": "npm run build && npx http-server docs -p 8080 --silent",
    "clean": "rm -rf docs output temp",
    "lint:light": "markdownlint 'src/**/*.md' --ignore node_modules",
    "test:light": "npm run lint:light && npm run build",
    "help": "echo 'Available commands:\n  npm run setup - Interactive setup\n  npm run build - Build the book\n  npm run check:security - Run npm audit without optional dependencies\n  npm run preview - Local preview'",
    "check:metadata": "node scripts/check-metadata-consistency.js",
    "check:security": "npm audit --omit=optional",
    "build:safe": "node scripts/build-with-conflict-detection.js"
  },
  "dependencies": {
    "fs-extra": "^11.3.0",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "markdownlint-cli": "^0.48.0"
  },
  "keywords": [
    "book",
    "publishing",
    "markdown",
    "github-pages",
    "template",
    "easy-setup"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itdojp/practical-auth-book.git"
  },
  "bugs": {
    "url": "https://github.com/itdojp/practical-auth-book/issues"
  },
  "homepage": "https://itdojp.github.io/practical-auth-book/"
}
